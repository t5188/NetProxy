					"geosite:category-games@cn",
					"domain:steamserver.net",
					"domain:steamcontent.com",
					"domain:epicgamescdn.com",
					"domain:datarouter.ol.epicgames.com",
					"regexp:^.*download[.]epicgames[.]com$",
					"regexp:^.*epicgames-download.*$",
					"regexp:^level[0-9][.]blizzard[.]com$",
					"regexp:^.*blizzard.*cdn.*$",
					"regexp:^.*cdn.*blizzard.*$",
					"regexp:^blz.*[.]akamaized[.]net$"
				],
				"outboundTag": "direct"
			},
			{
				"type": "field",
				"domain": [
					"geosite:geolocation-!cn",
					"domain:bitcomet.com",
					"domain:redircdn.com",
					"domain:23img.com",
					"domain:66img.cc",
					"domain:imgly.net"
				],
