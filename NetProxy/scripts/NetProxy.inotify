#!/system/bin/sh
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "${SCRIPT_DIR}/settings.ini"
events=$1
monitor_file=$3

if [ "${monitor_file}" == "disable" ]; then
  case "${events}" in
  "d")
    ${SCRIPT_DIR}/NetProxy.service enable >/dev/null 2>&1
    ;;
  "n")
    ${SCRIPT_DIR}/NetProxy.service disable >/dev/null 2>&1
    ;;
  esac
fi

